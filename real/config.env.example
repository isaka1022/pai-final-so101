# Copy to real/config.env. Ports come from `real/so101.sh ports`, the camera index from `real/so101.sh cameras`.
FOLLOWER_PORT=/dev/tty.usbmodemXXXX
LEADER_PORT=/dev/tty.usbmodemYYYY
WRIST_CAMERA=0
DISPLAY_DATA=true

TASK="pick up the cube and put it on the square"
EPISODES=50
EPISODE_SECONDS=20
RESET_SECONDS=8
TRAIN_STEPS=30000
ROLLOUT_SECONDS=30
